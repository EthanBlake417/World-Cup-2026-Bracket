# Copy this file to .env.local for local development.

# Password for the /admin page (set this to anything you like).
ADMIN_PASSWORD=changeme

# Database connection string. When you add the Vercel Postgres / Neon
# integration in the dashboard this is set automatically in production. For local
# dev, run `vercel env pull .env.local` after linking the project to fill it in,
# or paste your Neon connection string here.
#
# The app reads DATABASE_URL first, then falls back to POSTGRES_URL.
DATABASE_URL=
# POSTGRES_URL=
